# Machine-specific paths for this demo. Copy to local.env beside it and edit; local.env is
# gitignored, so your layout never lands in a commit.
#
#   cp local.env.example local.env
#
# env.sh reads this before computing any default, so setting a root here is enough when your
# checkouts are grouped. Set the individual directories only where a component sits somewhere
# the roots do not explain. Everything is commented out: uncomment what you actually need.

# ---- roots -------------------------------------------------------------------------
# Where the repositories are checked out. The default is $HOME/Repos, which is one
# development machine's habit and nothing more.
#REPOS_ROOT="$HOME/Repos"

# The MBMS repositories, if they are grouped in a subdirectory of REPOS_ROOT. Set this to
# REPOS_ROOT itself if you cloned them all side by side.
#RTMBMS_ROOT="$REPOS_ROOT/rt-mbms"

# ---- individual components, where the roots do not explain them ---------------------
#TX_DIR="$RTMBMS_ROOT/rt-mbms-tx"
#GW_DIR="$RTMBMS_ROOT/rt-mbms-gw"
#BMSC_DIR="$RTMBMS_ROOT/rt-mbms-bmsc"
#MODEM_DIR="$RTMBMS_ROOT/rt-mbms-modem"
#CLIENT_DIR="$RTMBMS_ROOT/rt-mbms-client"
#APP_DIR="$RTMBMS_ROOT/rt-mbms-application"
#PORTAL_DIR="$RTMBMS_ROOT/rt-mbms-application-provider"

# ---- content -------------------------------------------------------------------------
# What the looping encoder plays. Missing is fine: it generates a test pattern instead.
#CONTENT_ROOT="$HOME/MWC_TV_RADIO"
#LIVE_SOURCE_MEDIA="$CONTENT_ROOT/TV_1.mp4"

# ---- the SoapySDR zmqrx bridge --------------------------------------------------------
# The bridge ships in this repository (../soapy-zmq-bridge); run its build.sh once and the
# launchers find it there. Set this only if you keep the built module somewhere else.
#SOAPY_SDR_PLUGIN_PATH="$HOME/soapy-zmq-bridge"
